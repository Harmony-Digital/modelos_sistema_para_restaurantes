# Banco (local: saída de `pnpm db:start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cifra do telefone e HMAC do wa_id — 32 bytes base64. NUNCA reutilizar entre ambientes.
PHONE_ENC_KEY=
WA_ID_PEPPER=
# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Token e versão da Graph API: só o worker (envio). A web não recebe o token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v24.0
# OpenRouter
OPENROUTER_API_KEY=
# Modelos de triagem, separados por vírgula (principal primeiro, depois fallback). Escolha pendente dos evals; hoje: mistralai/mistral-nemo,google/gemini-2.5-flash-lite
AI_TRIAGE_MODELS=
# Supabase (painel)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional
SENTRY_DSN=
LOG_LEVEL=info
