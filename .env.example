# Banco (local: saída de `pnpm db:start`)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Cifra do telefone e HMAC do wa_id — 32 bytes base64. NUNCA reutilizar entre ambientes.
PHONE_ENC_KEY=
WA_ID_PEPPER=
# WhatsApp Cloud API
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Token e versão da Graph API: só o worker (envio). A web não recebe o token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v24.0
# Provedor de IA: openrouter (padrão; desenvolvimento local, modelos grátis) | openai (produção — o worker recusa outro
# provedor com NODE_ENV=production). Os nomes em AI_*_MODELS são os do provedor escolhido.
AI_PROVIDER=openrouter
# OpenRouter (obrigatória só com AI_PROVIDER=openrouter)
OPENROUTER_API_KEY=
# OpenAI (obrigatória só com AI_PROVIDER=openai; chave do PROJETO). OPENAI_BASE_URL só para teste local (servidor falso)
OPENAI_API_KEY=
# Modelos de triagem, separados por vírgula (principal primeiro, depois fallback).
# Local (OpenRouter): modelos grátis (ex.: nvidia/…:free, com OPENROUTER_DEV_SEM_ZDR=1).
# Produção (OpenAI): gpt-4.1-mini — todo modelo precisa de preço em packages/ai/src/precos-openai.ts ou o worker não sobe
AI_TRIAGE_MODELS=
# Modelos de leitura de cardápio (PDF/foto), separados por vírgula. Opcional: vazio = importação por IA desligada (só CSV)
# Produção (OpenAI): gpt-4.1-mini,gpt-4.1
AI_INGEST_MODELS=
# SÓ PARA DESENVOLVIMENTO: 1 libera modelos sem ZDR (grátis). O worker recusa em produção (NODE_ENV=production). Padrão 0
OPENROUTER_DEV_SEM_ZDR=0
# Storage do Supabase lido pelo worker (cardápio e importações). Obrigatórias no worker
SUPABASE_URL=http://127.0.0.1:54321
# ATENÇÃO: chave de serviço (ignora RLS). SÓ no servidor/worker — nunca em variável NEXT_PUBLIC_, no navegador, em log ou commit
SUPABASE_SERVICE_ROLE_KEY=
# Supabase (painel)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Opcional
SENTRY_DSN=
LOG_LEVEL=info

# Limite de upload do cardápio em MB (inteiro 1–20, padrão 20). Use 4 na Vercel (corpo limitado a ~4,5 MB).
# NEXT_PUBLIC_LIMITE_UPLOAD_MB=4
# Amostra em produção: WHATSAPP_* recebem valores aleatórios (nada sai pela Meta; o webhook segue exigindo HMAC válido).
